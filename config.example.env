# Presidio analyzer service base URL
PRESIDIO_ANALYZER_URL=http://presidio-analyzer

# Upstream LLM API base URL (OpenAI-compatible)
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Port the proxy listens on
PORT=8080

# Log incoming HTTP traffic (true/false)
HTTP_LOG=false

# Log outgoing upstream HTTP traffic (true/false).
# Note: anonymized request bodies are logged; passthrough bodies never are.
UPSTREAM_LOG=false

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Comma-separated ISO 639-1 codes the language detector may choose from
# when analyzing text (default: en,de)
ANALYZER_LANGUAGES=en,de

# Enable the gitleaks secret redaction stage (true/false, default: true)
SECRET_SCAN_ENABLED=true

# Path to a custom gitleaks TOML config. When empty, the gitleaks default
# config is used.
# GITLEAKS_CONFIG=/path/to/gitleaks.toml

# Maximum accepted request body size in bytes. Bodies are buffered for
# anonymization, so this caps memory use per request (default: 10485760 = 10 MiB)
# MAX_REQUEST_BODY_BYTES=10485760
